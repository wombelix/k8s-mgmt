{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':enablePreCommit'],
  customManagers: [
    {
      // Release file URLs in infrastructure/system-upgrade/kustomization.yaml
      customType: 'regex',
      managerFilePatterns: ['/^infrastructure/system-upgrade/kustomization\\.yaml$/'],
      matchStrings: [
        'https://github\\.com/(?<depName>rancher/system-upgrade-controller)/releases/download/(?<currentValue>v[^/]+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
  ],
}
